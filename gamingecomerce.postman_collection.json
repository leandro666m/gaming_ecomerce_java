        {
          "name": "Get games by platform",
          "request": { "method": "GET", "url": "{{baseUrl}}/platforms/{{platformId}}/games" }
        },
        {
          "name": "Create game for platform",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Last of Us Part II\",\n  \"slug\": \"the-last-of-us-part-ii\",\n  \"price\": 59.99,\n  \"summary\": \"Action-adventure game\",\n  \"video\": \"https://example.com/video\",\n  \"cover\": \"https://example.com/cover.jpg\",\n  \"wallpaper\": \"https://example.com/wallpaper.jpg\",\n  \"screenshots\": [\"https://example.com/screenshot-1.jpg\"],\n  \"discount\": 0,\n  \"releaseDate\": \"2020-06-19\",\n  \"platformId\": {{platformId}}\n}"
            },
            "url": "{{baseUrl}}/platforms/{{platformId}}/games"
          }
        },
        {
          "name": "Update game",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Last of Us Part II Updated\",\n  \"slug\": \"the-last-of-us-part-ii\",\n  \"price\": 49.99,\n  \"summary\": \"Updated description\",\n  \"video\": \"https://example.com/video\",\n  \"cover\": \"https://example.com/cover.jpg\",\n  \"wallpaper\": \"https://example.com/wallpaper.jpg\",\n  \"screenshots\": [],\n  \"discount\": 10,\n  \"releaseDate\": \"2020-06-19\",\n  \"platformId\": {{platformId}}\n}"
