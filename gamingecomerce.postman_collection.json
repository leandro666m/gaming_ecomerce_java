{
  "info": {
    "_postman_id": "b3e2d1e5-7c11-4f6e-9a0e-gaming-ecommerce",
    "name": "Gaming Ecommerce API",
    "description": "Coleccion completa de endpoints de la aplicacion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "clientId", "value": "1" },
    { "key": "addressId", "value": "1" },
    { "key": "platformId", "value": "1" },
    { "key": "gameId", "value": "1" },
    { "key": "wishlistId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "orderItemId", "value": "1" },
    { "key": "username", "value": "player01" },
    { "key": "email", "value": "player01@example.com" },
    { "key": "platformSlug", "value": "playstation-5" },
    { "key": "gameSlug", "value": "the-last-of-us-part-ii" },
    { "key": "paymentId", "value": "PAY-001" }
  ],
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Get all clients",
          "request": { "method": "GET", "url": "{{baseUrl}}/clients" }
        },
        {
          "name": "Get client by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/clients/{{clientId}}" }
        },
        {
          "name": "Get client by username",
          "request": { "method": "GET", "url": "{{baseUrl}}/clients/username/{{username}}" }
        },
        {
          "name": "Get client by email",
          "request": { "method": "GET", "url": "{{baseUrl}}/clients/email/{{email}}" }
        },
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player01\",\n  \"email\": \"player01@example.com\",\n  \"password\": \"secret123\",\n  \"firstName\": \"Player\",\n  \"lastName\": \"One\"\n}"
            },
            "url": "{{baseUrl}}/clients"
          }
        },
        {
          "name": "Update client",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"player01\",\n  \"email\": \"player01@example.com\",\n  \"password\": \"secret123\",\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Player\"\n}"
            },
            "url": "{{baseUrl}}/clients/{{clientId}}"
          }
        },
        {
          "name": "Delete client",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/clients/{{clientId}}" }
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "Get all addresses",
          "request": { "method": "GET", "url": "{{baseUrl}}/addresses" }
        },
        {
          "name": "Get address by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/addresses/{{addressId}}" }
        },
        {
          "name": "Get addresses by client",
          "request": { "method": "GET", "url": "{{baseUrl}}/clients/{{clientId}}/addresses" }
        },
        {
          "name": "Create address for client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Casa\",\n  \"address\": \"Av. Siempre Viva 123\",\n  \"city\": \"Buenos Aires\",\n  \"state\": \"Buenos Aires\",\n  \"postalCode\": \"C1000\",\n  \"phone\": \"+5491122334455\"\n}"
            },
            "url": "{{baseUrl}}/clients/{{clientId}}/addresses"
          }
        },
        {
          "name": "Update address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Casa actualizada\",\n  \"address\": \"Av. Siempre Viva 456\",\n  \"city\": \"Buenos Aires\",\n  \"state\": \"Buenos Aires\",\n  \"postalCode\": \"C1000\",\n  \"phone\": \"+5491122334455\"\n}"
            },
            "url": "{{baseUrl}}/addresses/{{addressId}}"
          }
        },
        {
          "name": "Delete address",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/addresses/{{addressId}}" }
        }
      ]
    },
