    {
      "name": "Wishlists",
      "item": [
        {
          "name": "Get all wishlists",
          "request": { "method": "GET", "url": "{{baseUrl}}/wishlists" }
        },
        {
          "name": "Get wishlist by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/wishlists/{{wishlistId}}" }
        },
        {
          "name": "Get wishlist by client",
          "request": { "method": "GET", "url": "{{baseUrl}}/clients/{{clientId}}/wishlist" }
        },
        {
          "name": "Create wishlist for client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameIds\": [{{gameId}}]\n}"
            },
            "url": "{{baseUrl}}/clients/{{clientId}}/wishlist"
          }
        },
        {
          "name": "Add game to wishlist",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wishlists/{{wishlistId}}/games/{{gameId}}"
          }
        },
        {
          "name": "Remove game from wishlist",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/wishlists/{{wishlistId}}/games/{{gameId}}"
          }
        },
        {
          "name": "Delete wishlist",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/wishlists/{{wishlistId}}" }
        }
      ]
    },
